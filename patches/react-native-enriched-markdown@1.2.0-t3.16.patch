   private val data = ConcurrentHashMap<Int, MeasurementParams>()
 
+  // The width and document a split (container) view was last measured for, and the
+  // height its segments really took once laid out there. The split estimate builds
+  // StaticLayouts that can disagree with the segment TextViews (a quote inside a
+  // list item comes out short), so the container reports what it laid out and the
+  // next measure of the same width and document returns that instead.
+  private data class SplitKey(
+    val width: Float,
+    val markdownHash: Int,
+  )
+
+  private data class LaidOutHeight(
+    val key: SplitKey,
+    val heightDip: Float,
+  )
+
+  private val lastSplitKeys = ConcurrentHashMap<Int, SplitKey>()
+  private val laidOutHeights = ConcurrentHashMap<Int, LaidOutHeight>()
+
+  /** Records the height a split view's segments took. Returns true when Yoga should re-measure. */
+  fun storeLaidOutHeight(
+    id: Int,
+    heightPx: Int,
+  ): Boolean {
+    val key = lastSplitKeys[id] ?: return false
+    val heightDip = PixelUtil.toDIPFromPixel(heightPx.toFloat())
+    val previous = laidOutHeights[id]
+    if (previous != null && previous.key == key && kotlin.math.abs(previous.heightDip - heightDip) < 0.5f) return false
+    laidOutHeights[id] = LaidOutHeight(key, heightDip)
+    return true
+  }
+
