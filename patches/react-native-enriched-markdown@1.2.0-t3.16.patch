+  // Hands Yoga the height the segments really took when it differs from the
+  // split estimate; otherwise the frame stays short and the text overlaps
+  // whatever follows it.
+  private fun reportLaidOutHeight() {
+    if (width <= 0 || segmentViews.isEmpty()) return
+    val contentHeight = computeSegmentsTotalHeight() - paddingTop - paddingBottom
+    val frameHeight = height - paddingTop - paddingBottom
+    if (kotlin.math.abs(contentHeight - frameHeight) <= 1) return
+    if (!MeasurementStore.storeLaidOutHeight(id, contentHeight)) return
+    val wrapper = stateWrapper ?: return
+    val state = Arguments.createMap()
+    state.putInt("forceHeightRecalculationCounter", ++forceHeightRecalculationCounter)
+    wrapper.updateState(state)
+  }
+
