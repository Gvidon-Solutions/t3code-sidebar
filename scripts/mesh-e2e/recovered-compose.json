{
  "name": "t3-mesh-e2e-X1-recovered",
  "services": {
    "t3": {
      "image": "t3-mesh-e2e:dev",
      "container_name": "t3-mesh-e2e",
      "restart": "unless-stopped",
      "ports": ["127.0.0.1:3791:3791"],
      "volumes": ["./home:/home/t3", "./tmp:/tmp", "./var-tmp:/var/tmp"],
      "environment": {
        "TZ": "Europe/Moscow",
        "MUTAGEN_DATA_DIRECTORY": "/home/t3/.mutagen",
        "HTTPS_PROXY": "http://172.17.0.1:14444",
        "HTTP_PROXY": "http://172.17.0.1:14444",
        "ALL_PROXY": "http://172.17.0.1:14444",
        "NO_PROXY": "localhost,127.0.0.1,0.0.0.0,::1,172.17.0.1,192.168.0.0/16,10.0.0.0/8",
        "HOME": "/home/t3",
        "T3_MESH_SSH_HOME": "/home/t3",
        "T3_MESH_AGENT_HOME": "/home/t3"
      },
      "security_opt": ["no-new-privileges:true"],
      "cap_drop": ["ALL"],
      "mem_limit": "4g",
      "memswap_limit": "4g",
      "cpus": 4,
      "pids_limit": 512,
      "init": false,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "command": [
        "sh",
        "-c",
        "node /tmp/X1-N1-network-proxy.mjs 13797 13797 /tmp/X1-N1-outbound-state.json 127.0.0.1 172.17.0.1 & /usr/sbin/sshd -D -e -f /tmp/X1-N1-sshd_config & exec node /opt/t3/dist/bin.mjs serve --base-dir /home/t3/.t3 --host 0.0.0.0 --port 3791 --no-browser"
      ],
      "hostname": "cloudbox"
    }
  }
}
