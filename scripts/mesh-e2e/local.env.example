# Copy to local.env (gitignored); use disposable Linux hosts with systemd and Docker.
# All private infrastructure and installed tool locations belong in that one file.
NODE_B_SSH_CONFIG="$HOME/.config/mesh-bed/node-b.conf"
NODE_B_SSH_KEY="$HOME/.local/state/t3-mesh-e2e/ssh/node-b-admin"
NODE_B_HOST=node-b.example.test
CLOUD_SSH_CONFIG="$HOME/.config/mesh-bed/cloud.conf"
CLOUD_KNOWN_HOSTS="$HOME/.config/mesh-bed/known_hosts"
CLOUD_HOST=cloud.example.test
CLOUD_SSH_USER=bed
NODE_A_PUBLIC_IP=192.0.2.11
NODE_B_PUBLIC_IP=192.0.2.12
NODE_A_NODE_BIN_DIR=/usr/local/bin
NODE_B_NODE_BIN_DIR=/usr/local/bin
NODE_B_STATE_DIR=/srv/t3-mesh-e2e/nodeB
NODE_B_DEMO_DIR="$NODE_B_STATE_DIR/projects/demo"
CLOUD_DIR=/srv/t3-mesh-e2e/cloud
